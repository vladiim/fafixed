#!/usr/bin/env bash

# Initial build and collect
npm run build
uv run python manage.py collectstatic --noinput

# Start Redis server if not running
if ! pgrep -f redis-server > /dev/null; then
    echo "Starting Redis server..."
    redis-server --daemonize yes --port 6379
    REDIS_STARTED=true
fi

# Start Celery worker in background
echo "Starting Celery worker..."
uv run celery -A fafixed worker --loglevel=info &
CELERY_PID=$!

# Start Tailwind CSS watcher in background with polling for reliable file watching
CHOKIDAR_USEPOLLING=1 npx tailwindcss -i ./static/src/input.css -o ./static/dist/styles.css --watch &
TAILWIND_PID=$!

# Function to collect static files when CSS changes
collect_static() {
    while inotifywait -e modify ./static/dist/styles.css 2>/dev/null; do
        uv run python manage.py collectstatic --noinput > /dev/null 2>&1
    done &
    INOTIFY_PID=$!
}

# Start file watcher if inotifywait is available, otherwise skip
if command -v inotifywait > /dev/null; then
    collect_static
fi

# Function to kill background processes
cleanup() {
    echo "Stopping development server..."
    kill $TAILWIND_PID 2>/dev/null
    kill $INOTIFY_PID 2>/dev/null
    kill $CELERY_PID 2>/dev/null
    if [ "$REDIS_STARTED" = true ]; then
        echo "Stopping Redis server..."
        redis-cli shutdown
    fi
    exit
}

# Set trap to cleanup on script exit
trap cleanup INT TERM

# Start Django ASGI server with daphne for WebSocket support
echo "Starting Django ASGI server with daphne..."
uv run daphne -b 0.0.0.0 -p 8000 fafixed.asgi:application

# Kill background processes when Django server stops
cleanup
